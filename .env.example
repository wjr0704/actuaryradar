# ActuaryRadar environment variables
# Copy this file to .env locally and fill in real values.
# Do not commit real credentials.

# Legacy optional local email digest delivery
GMAIL_ADDRESS=your_email@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password
ACTUARY_DIGEST_EMAIL_FROM=your_email@example.com
ACTUARY_DIGEST_EMAIL_PASSWORD=your_email_password

# Production newsletter subscription and delivery
RESEND_API_KEY=your_resend_api_key
DAILY_BRIEFING_FROM=ActuaryRadar <briefing@example.com>
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
# Preferred server-side key for new Supabase projects
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy fallback only
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: authoritative-source search providers
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Optional Resume Studio overrides. The service uses OPENAI_MODEL when
# CAREER_OPENAI_MODEL is unset and hashes client IPs before rate limiting.
CAREER_OPENAI_MODEL=gpt-4o-mini
CAREER_RATE_LIMIT_SECRET=replace_with_a_long_random_secret
TAVILY_API_KEY=your_tavily_api_key
BING_WEB_SEARCH_API_KEY=your_bing_web_search_api_key
SERPAPI_API_KEY=your_serpapi_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key
PERPLEXITY_MODEL=sonar

# Optional future backend
DATABASE_URL=postgresql://user:password@host:5432/database

# Deployment
SITE_BASE_URL=https://insuranceactuaryhub.com
